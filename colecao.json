          "name": "loginUsuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Verifica se o login deu sucesso (Status 200)",
                  "pm.test(\"Login realizado com sucesso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Captura o corpo da resposta",
                  "var resposta = pm.response.json();",
                  "",
                  "// Salva o token gerado na variável de ambiente do Postman",
                  "pm.environment.set(\"token_jwt\", resposta.token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
