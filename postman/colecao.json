                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// A sync do Codeforces e @Async: numa base recem-criada o Mongo ainda esta vazio.",
                      "// Sem um idProblema real, esta requisicao daria 404 -- entao ela e pulada.",
                      "if (!pm.environment.get(\"idProblema\")) {",
                      "    console.log(\"Nenhum problema no Mongo ainda - pulando \" + pm.info.requestName);",
                      "    if (typeof pm.execution !== \"undefined\" && pm.execution.skipRequest) {",
